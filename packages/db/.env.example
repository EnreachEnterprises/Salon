# Copy to .env and fill in. Never commit .env.
#
# Pooled connection (host contains "-pooler"): used by the API at runtime.
# Neon's pooled endpoint multiplexes many short-lived serverless connections.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/salon?sslmode=require"

# Direct (unpooled) connection: used only by migrations and the seed, which need
# a real session for DDL, transactions and SET LOCAL. Do not use at runtime.
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxx.region.aws.neon.tech/salon?sslmode=require"
